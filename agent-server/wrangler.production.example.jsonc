{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "liuying-agent-example",
  "account_id": "<YOUR_CLOUDFLARE_ACCOUNT_ID>",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "triggers": {
    "crons": []
  },
  "secrets": {
    "required": [
      "DEEPSEEK_API_KEY",
      "FUN_ASR_API_KEY"
    ]
  },
  "vars": {
    "FUN_ASR_WORKSPACE_ID": "",
    "FUN_ASR_REGION": "cn-beijing",
    "FUN_ASR_VOCABULARY_ID": ""
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "AGENT_RUNTIME",
        "class_name": "LiuyingAgentRuntime"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "LiuyingAgentRuntime"
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "liuying-agent-example",
      "database_id": "<YOUR_D1_DATABASE_ID>",
      "migrations_dir": "migrations",
      "remote": false
    }
  ],
  "rules": [
    {
      "type": "Data",
      "globs": [
        "**/*.bin"
      ],
      "fallthrough": false
    }
  ],
  "build": {
    "command": "node --experimental-strip-types tools/token-count/prepare-worker-assets.ts"
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    },
    "traces": {
      "enabled": true
    }
  }
}
