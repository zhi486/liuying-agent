{
  "name": "liuying-agent-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "22.22.2",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
