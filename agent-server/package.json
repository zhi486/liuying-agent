{
  "name": "liuying-agent-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "22.22.2",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:workers": "tsc -p tsconfig.workers.json",
    "preflight:config": "node --experimental-strip-types tools/config-preflight.mjs",
    "verify:token-assets": "node --experimental-strip-types tools/token-count/verify-assets.ts",
    "prepare:worker-assets": "node --experimental-strip-types tools/token-count/prepare-worker-assets.ts",
    "test:runtime": "corepack pnpm prepare:worker-assets && vitest run",
    "test:disconnect": "corepack pnpm build:worker && node --experimental-strip-types tools/verify-runtime-disconnect.mjs",
    "test:restart": "corepack pnpm build:worker && node --experimental-strip-types tools/verify-runtime-restart.mjs && node --experimental-strip-types tools/verify-runtime-restart.mjs no-receipt",
    "types:worker": "wrangler types --include-runtime false --strict-vars false",
    "build:worker": "wrangler deploy --dry-run --outdir .generated/bundle",
    "check": "corepack pnpm verify:token-assets && corepack pnpm typecheck && corepack pnpm typecheck:workers && corepack pnpm test"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.9",
    "@cloudflare/workers-types": "5.20260915.1",
    "@types/node": "22.18.0",
    "miniflare": "5.20260911.1-alpha",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "wrangler": "4.131.2"
  },
  "dependencies": {
    "@huggingface/tokenizers": "0.2.0"
  }
}
