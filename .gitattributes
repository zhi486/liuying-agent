# 自动检测文本文件并标准化换行符
* text=auto

# Kotlin / Gradle 源代码 — Unix 换行符（跨平台一致）
*.kt text eol=lf
*.kts text eol=lf
*.gradle text eol=lf

# Python — Unix 换行符
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf

# Shell 脚本 — Unix 换行符
*.sh text eol=lf

# Windows 批处理 — Windows 换行符
*.bat text eol=crlf
*.ps1 text eol=crlf
*.cmd text eol=crlf

# Markdown — 保持原样
*.md text

# 二进制文件
*.png binary
*.jpg binary
*.jks binary
*.keystore binary
*.apk binary
*.aab binary
*.jar binary

# React / TypeScript - Unix 换行符
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.json text eol=lf
